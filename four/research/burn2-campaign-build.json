{
  "description": "Replay the expanded supplementary census from frozen compact inputs. No discovery search; global union accounting also requires the original 113-board checkpoint.",
  "steps": [
    {
      "id": "core",
      "depends": [],
      "command": [
        "make",
        "-C",
        "four",
        "all",
        "-j2"
      ],
      "boards": [
        "BBB24.ChampionCensusNext"
      ]
    },
    {
      "id": "next-rw",
      "depends": [
        "core"
      ],
      "command": [
        "python3",
        "four/tools/replay_next_rw.py",
        "--timeout",
        "120",
        "--audit-timeout",
        "1200"
      ],
      "boards": [
        "BBB24NextRW.Batch32V1All"
      ]
    },
    {
      "id": "next-timeout",
      "depends": [
        "core"
      ],
      "command": [
        "python3",
        "four/tools/check_next_timeout.py",
        "run",
        "--batch",
        "nonrw-v1",
        "--modes",
        "ng,finite,hist",
        "--timeout",
        "60",
        "--audit-timeout",
        "1800",
        "--resume"
      ],
      "boards": [
        "BBB24NextTimeoutNonrwV1.All"
      ]
    },
    {
      "id": "next-weighted-state",
      "depends": [
        "core"
      ],
      "command": [
        "python3",
        "four/tools/replay_next_weighted_state.py",
        "--report",
        "four/research/next-weighted-state-checked.json",
        "--resume"
      ],
      "boards": [
        "BBB24NextWeightedState.WeightedStateAll"
      ]
    },
    {
      "id": "next-capacity",
      "depends": [
        "core"
      ],
      "command": [
        "python3",
        "four/tools/replay_next_capacity.py",
        "--output-dir",
        "four/build/next-capacity",
        "--timeout",
        "300",
        "--audit-timeout",
        "900"
      ],
      "boards": [
        "BBB24NextCapacityInventory.Capacity",
        "BBB24NextCapacityInventory.Portfolio"
      ]
    },
    {
      "id": "burn2-state-pilot",
      "depends": [
        "core"
      ],
      "command": [
        "python3",
        "four/tools/check_burn2_weighted_state.py",
        "--input",
        "four/research/burn2-state-pilot-input.json",
        "--report",
        "four/research/burn2-state-pilot-checked.json",
        "--inventory",
        "four/research/burn2-state-pilot-machines.json",
        "--output-dir",
        "four/build/burn2-state/weighted-pilot-proof",
        "--namespace",
        "BBB24Burn2StatePilot",
        "--shard-size",
        "4",
        "--timeout",
        "300",
        "--audit-timeout",
        "1800",
        "--resume"
      ],
      "boards": [
        "BBB24Burn2StatePilot.WeightedStateAll"
      ]
    },
    {
      "id": "burn2-capacity",
      "depends": [
        "core"
      ],
      "command": [
        "python3",
        "four/tools/check_burn2_capacity.py"
